# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Game
# First puzzle date (YYYY-MM-DD). Puzzle number = days since this date + 1.
LAUNCH_DATE=2026-11-09
# Comma-separated emails allowed into /admin
ADMIN_EMAILS=
# Shared secret Vercel Cron sends as a Bearer token
CRON_SECRET=

# Email (Resend, sending-only key restricted to changel.app)
RESEND_API_KEY=

# Cloudflare Turnstile
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Upstash Redis (rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic (server-only: nightly content pipeline)
ANTHROPIC_API_KEY=

# Monitoring and analytics
SENTRY_DSN=
# Plausible (cookieless; chosen over PostHog, see DECISIONS.md)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Test-only: lets tests pin the server clock with the x-changel-test-now header.
# Never set on Vercel production (also ignored there by code).
ALLOW_TEST_CLOCK=
